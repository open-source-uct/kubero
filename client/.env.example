# ==============================================================================
# Kubero E2E Playwright - Plantilla de Variables de Entorno
# Copiar este archivo a .env y ajustar valores según sea necesario
# ==============================================================================

# URL base del frontend Kubero
E2E_BASE_URL=http://localhost:2000

# Credenciales de autenticación local
E2E_USERNAME=admin
E2E_PASSWORD=tu_password_aqui

# Configuración de ejecución de pruebas
E2E_HEADLESS=true
E2E_BROWSER=chromium
E2E_TIMEOUT=30000

# Dimensiones de pantalla
E2E_VIEWPORT_WIDTH=1280
E2E_VIEWPORT_HEIGHT=720

# Detección de errores en consola
E2E_FAIL_ON_CONSOLE_ERROR=true

# Ruta de almacenamiento de sesión
E2E_STORAGE_STATE_PATH=./e2e/.auth/user.json
